#!/bin/bash
set -euo pipefail

AWS_REGION="${aws_region}"
NODE_NAME="${node_name}"
IS_MASTER="${is_master}"
IS_DATA="${is_data}"
AZ="${az}"
SEED_HOSTS_JSON='${seed_hosts}'
INITIAL_MASTERS_JSON='${initial_master_nodes}'

SECRET_ELASTIC_PASSWORD="${elastic_master_password_secret}"
SECRET_ES_TLS="${es_tls_secret}"
SECRET_CA_CERT="${ca_cert_secret}"

mkdir -p /opt/siem

install_base_packages() {
  if command -v dnf >/dev/null 2>&1; then
    dnf -y update
    dnf -y install awscli jq unzip openssl curl amazon-cloudwatch-agent
  elif command -v apt-get >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y jq unzip openssl curl ca-certificates gnupg

    if ! command -v /opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl >/dev/null 2>&1; then
      curl -fsSL -o /tmp/amazon-cloudwatch-agent.deb \
        https://s3.amazonaws.com/amazoncloudwatch-agent/ubuntu/amd64/latest/amazon-cloudwatch-agent.deb
      dpkg -i /tmp/amazon-cloudwatch-agent.deb || apt-get -f install -y
    fi
  else
    echo "Unsupported OS: neither dnf nor apt-get found" >&2
    exit 1
  fi
}

install_aws_cli() {
  if command -v aws >/dev/null 2>&1; then
    return 0
  fi

  curl -fsSL -o /tmp/awscliv2.zip https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
}

install_elastic() {
  if command -v dnf >/dev/null 2>&1; then
    if [ ! -f /etc/yum.repos.d/elastic-8.x.repo ]; then
      rpm --import https://artifacts.elastic.co/GPG-KEY-elasticsearch
      cat >/etc/yum.repos.d/elastic-8.x.repo <<'REPO'
[elastic-8.x]
name=Elastic repository for 8.x packages
baseurl=https://artifacts.elastic.co/packages/8.x/yum
gpgcheck=1
gpgkey=https://artifacts.elastic.co/GPG-KEY-elasticsearch
enabled=1
autorefresh=1
type=rpm-md
REPO
    fi
    dnf -y install elasticsearch
  else
    if [ ! -f /etc/apt/sources.list.d/elastic-8.x.list ]; then
      curl -fsSL https://artifacts.elastic.co/GPG-KEY-elasticsearch | gpg --dearmor -o /usr/share/keyrings/elastic.gpg
      echo "deb [signed-by=/usr/share/keyrings/elastic.gpg] https://artifacts.elastic.co/packages/8.x/apt stable main" \
        >/etc/apt/sources.list.d/elastic-8.x.list
      apt-get update -y
    fi
    apt-get install -y elasticsearch
  fi

  # Prevent Elasticsearch 8.x from starting (and auto-configuring security) before we
  # finish writing the desired config + keystore bootstrap password.
  systemctl stop elasticsearch >/dev/null 2>&1 || true
  systemctl disable elasticsearch >/dev/null 2>&1 || true
}

install_base_packages

install_aws_cli

install_elastic

mkdir -p /etc/elasticsearch/certs
chmod 750 /etc/elasticsearch/certs
chown -R elasticsearch:elasticsearch /etc/elasticsearch

if ! /usr/share/elasticsearch/bin/elasticsearch-plugin list | grep -q '^repository-s3$'; then
  /usr/share/elasticsearch/bin/elasticsearch-plugin install --batch repository-s3
fi

ELASTIC_PASSWORD="$(aws --region "$AWS_REGION" secretsmanager get-secret-value --secret-id "$SECRET_ELASTIC_PASSWORD" --query SecretString --output text)"

CA_CERT_PEM="$(aws --region "$AWS_REGION" secretsmanager get-secret-value --secret-id "$SECRET_CA_CERT" --query SecretString --output text)"
echo "$CA_CERT_PEM" >/etc/elasticsearch/certs/ca.crt
chmod 640 /etc/elasticsearch/certs/ca.crt
chown elasticsearch:elasticsearch /etc/elasticsearch/certs/ca.crt

TLS_JSON="$(aws --region "$AWS_REGION" secretsmanager get-secret-value --secret-id "$SECRET_ES_TLS" --query SecretString --output text)"
echo "$TLS_JSON" | jq -r .crt >/etc/elasticsearch/certs/elasticsearch.crt
echo "$TLS_JSON" | jq -r .key >/etc/elasticsearch/certs/elasticsearch.key
chmod 640 /etc/elasticsearch/certs/elasticsearch.crt /etc/elasticsearch/certs/elasticsearch.key
chown elasticsearch:elasticsearch /etc/elasticsearch/certs/elasticsearch.crt /etc/elasticsearch/certs/elasticsearch.key

cat >/etc/elasticsearch/elasticsearch.yml <<EOF
cluster.name: elk-siem
node.name: ${node_name}
node.master: ${is_master}
node.data: ${is_data}
node.attr.aws_availability_zone: ${az}

network.host: 0.0.0.0
discovery.seed_hosts: $SEED_HOSTS_JSON
cluster.initial_master_nodes: $INITIAL_MASTERS_JSON

cluster.routing.allocation.awareness.attributes: aws_availability_zone

xpack.security.autoconfiguration.enabled: false
xpack.security.enabled: true

xpack.security.transport.ssl.enabled: true
xpack.security.transport.ssl.verification_mode: certificate
xpack.security.transport.ssl.key: certs/elasticsearch.key
xpack.security.transport.ssl.certificate: certs/elasticsearch.crt
xpack.security.transport.ssl.certificate_authorities: ["certs/ca.crt"]

xpack.security.http.ssl.enabled: true
xpack.security.http.ssl.key: certs/elasticsearch.key
xpack.security.http.ssl.certificate: certs/elasticsearch.crt
xpack.security.http.ssl.certificate_authorities: ["certs/ca.crt"]

path.data: /var/lib/elasticsearch
path.logs: /var/log/elasticsearch
EOF
chown elasticsearch:elasticsearch /etc/elasticsearch/elasticsearch.yml
chmod 640 /etc/elasticsearch/elasticsearch.yml

if [ ! -f /etc/elasticsearch/jvm.options.d/heap.options ]; then
  mkdir -p /etc/elasticsearch/jvm.options.d
  cat >/etc/elasticsearch/jvm.options.d/heap.options <<'EOF'
-Xms4g
-Xmx4g
EOF
  chown -R elasticsearch:elasticsearch /etc/elasticsearch/jvm.options.d
fi

if [ ! -f /etc/elasticsearch/elasticsearch.keystore ]; then
  /usr/share/elasticsearch/bin/elasticsearch-keystore create
  chown elasticsearch:elasticsearch /etc/elasticsearch/elasticsearch.keystore
  chmod 600 /etc/elasticsearch/elasticsearch.keystore
fi

echo "$ELASTIC_PASSWORD" | /usr/share/elasticsearch/bin/elasticsearch-keystore add -xf 'bootstrap.password'

systemctl daemon-reload
systemctl enable elasticsearch
systemctl restart elasticsearch

if [ "${is_master}" = "true" ]; then
  # Configure the built-in kibana_system user password to match the secret-driven value.
  # Kibana 8.19+ forbids using the "elastic" superuser in kibana.yml.
  for i in $(seq 1 60); do
    if curl -sk --cacert /etc/elasticsearch/certs/ca.crt -u "elastic:$ELASTIC_PASSWORD" https://localhost:9200 >/dev/null 2>&1; then
      curl -sk --cacert /etc/elasticsearch/certs/ca.crt -u "elastic:$ELASTIC_PASSWORD" \
        -X POST https://localhost:9200/_security/user/kibana_system/_password \
        -H 'Content-Type: application/json' \
        -d "{\"password\":\"$ELASTIC_PASSWORD\"}" >/dev/null 2>&1 || true
      break
    fi
    sleep 5
  done
fi

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWCFG'
{
  "metrics": {
    "metrics_collected": {
      "cpu": { "measurement": ["cpu_usage_idle","cpu_usage_iowait","cpu_usage_user","cpu_usage_system"], "metrics_collection_interval": 60, "totalcpu": true },
      "mem": { "measurement": ["mem_used_percent"], "metrics_collection_interval": 60 },
      "disk": { "measurement": ["used_percent"], "metrics_collection_interval": 60, "resources": ["*"] }
    }
  }
}
CWCFG

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json -s

cat >/opt/siem/publish_es_health.sh <<'EOF'
#!/bin/bash
set -euo pipefail

TOKEN="$(curl -sS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")"
REGION="$(curl -sS -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/dynamic/instance-identity/document | jq -r .region)"
STATUS="$(curl -sk -u "elastic:$(aws --region "$REGION" secretsmanager get-secret-value --secret-id "siem/elasticsearch/master-password" --query SecretString --output text)" https://localhost:9200/_cluster/health | jq -r .status || echo "unknown")"
VALUE=0
case "$STATUS" in
  green) VALUE=0 ;;
  yellow) VALUE=1 ;;
  red) VALUE=2 ;;
  *) VALUE=3 ;;
esac
aws --region "$REGION" cloudwatch put-metric-data --namespace "SIEM/Elasticsearch" --metric-data "MetricName=ClusterHealth,Value=$VALUE,Unit=None"
EOF
chmod 750 /opt/siem/publish_es_health.sh

cat >/etc/systemd/system/siem-es-health-metric.service <<'EOF'
[Unit]
Description=Publish Elasticsearch cluster health to CloudWatch

[Service]
Type=oneshot
ExecStart=/opt/siem/publish_es_health.sh
EOF

cat >/etc/systemd/system/siem-es-health-metric.timer <<'EOF'
[Unit]
Description=Run Elasticsearch health metric publisher every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min

[Install]
WantedBy=timers.target
EOF

systemctl daemon-reload
systemctl enable --now siem-es-health-metric.timer
